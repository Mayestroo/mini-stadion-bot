# ─── DATABASE ───────────────────────────────
POSTGRES_DB=maydoncha
POSTGRES_USER=andijan
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg://andijan:change-this-postgres-password@maydoncha_postgres:5432/maydoncha

# ─── BACKEND ────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM=HS256

# ─── FRONTEND ───────────────────────────────
NEXT_PUBLIC_API_URL=https://api.<DOMAIN>
# Get from https://console.cloud.google.com/apis/credentials (Maps JavaScript API + Places API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
NEXT_PUBLIC_APP_NAME=Maydoncha
NEXT_PUBLIC_APP_URL=https://<DOMAIN>

# ─── TELEGRAM BOT ───────────────────────────
# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://api.<DOMAIN>/api/v1/bot/webhook
TELEGRAM_WEBHOOK_SECRET=change-this-webhook-secret
MINI_APP_URL=https://<DOMAIN>/miniapp
ADMIN_TELEGRAM_IDS=

# ─── UPLOADS ────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ─── CORS ───────────────────────────────────
ALLOWED_ORIGINS=https://<DOMAIN>,https://www.<DOMAIN>

# ─── SENTRY (optional) ──────────────────────
# SENTRY_DSN=https://key@oXXXX.ingest.sentry.io/project
# NEXT_PUBLIC_SENTRY_DSN=https://key@oXXXX.ingest.sentry.io/project

# ─── ADMIN ──────────────────────────────────
FIRST_ADMIN_EMAIL=admin@maydoncha.uz
FIRST_ADMIN_PASSWORD=change-this-admin-password
