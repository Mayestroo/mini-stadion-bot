# ─── DATABASE ───────────────────────────────
POSTGRES_DB=andijan_futbol
POSTGRES_USER=andijan
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg://andijan:change-this-postgres-password@postgres:5432/andijan_futbol

# ─── BACKEND ────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM=HS256

# ─── FRONTEND ───────────────────────────────
NEXT_PUBLIC_API_URL=https://api.pentestlab.uz
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
NEXT_PUBLIC_APP_NAME=Andijon arena
NEXT_PUBLIC_APP_URL=https://pentestlab.uz

# ─── TELEGRAM BOT ───────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://api.pentestlab.uz/api/v1/bot/webhook
TELEGRAM_WEBHOOK_SECRET=change-this-webhook-secret
MINI_APP_URL=https://pentestlab.uz/miniapp
ADMIN_TELEGRAM_IDS=

# ─── UPLOADS ────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ─── CORS ───────────────────────────────────
ALLOWED_ORIGINS=https://pentestlab.uz,https://www.pentestlab.uz

# ─── ADMIN ──────────────────────────────────
FIRST_ADMIN_EMAIL=admin@andijanfutbol.uz
FIRST_ADMIN_PASSWORD=change-this-admin-password
